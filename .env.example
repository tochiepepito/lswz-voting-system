# ---------------------------------------------------------------------------
# Game Event Voting System — environment configuration
#
# Copy to `.env` for local development and fill in real values.
# Generate the three secrets with:  npm run secrets:generate
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# MySQL connection string used by the application at runtime.
# Create the schema in MySQL Workbench (or the CLI) before running migrations.
DATABASE_URL="mysql://voting:voting@localhost:3306/voting_system"

# Connection pool size is set on the URL itself for MySQL, e.g.
#   mysql://user:pass@host:3306/db?connection_limit=10&pool_timeout=20

# Separate database used by `npm run test:integration`.
# The integration suite TRUNCATES tables, so it must never point at real data.
# TEST_DATABASE_URL="mysql://voting:voting@localhost:3306/voting_system_test"

# --- Application -----------------------------------------------------------
# Canonical public origin. Used for CSRF / same-origin enforcement on every
# state-changing request. Must be the exact scheme + host + port.
APP_URL="http://localhost:3000"

# Comma-separated extra origins accepted for state-changing requests.
# Leave empty unless the app is genuinely served from more than one hostname.
# ADDITIONAL_ALLOWED_ORIGINS=""

# --- Secrets (32+ random bytes each, base64) -------------------------------
# Peppers the HMAC used to derive `Voter.nameHash` from a normalised IGN.
# Rotating this value orphans every existing voter identity — treat as permanent.
IGN_HASH_PEPPER="CHANGE_ME_run_npm_run_secrets_generate"

# Peppers the HMAC used to derive stored IP and user-agent hashes.
# Raw IP addresses are never written to the database.
IP_HASH_PEPPER="CHANGE_ME_run_npm_run_secrets_generate"

# Peppers the HMAC used for session-token lookup hashes and CSRF tokens.
SESSION_TOKEN_PEPPER="CHANGE_ME_run_npm_run_secrets_generate"

# --- Session lifetimes -----------------------------------------------------
ADMIN_SESSION_TTL_HOURS="12"
VOTER_SESSION_TTL_DAYS="30"

# --- Rate limiting ---------------------------------------------------------
# Vote submissions allowed per browser session, per rolling window.
RL_VOTE_SESSION_MAX="10"
RL_VOTE_SESSION_WINDOW_SECONDS="3600"

# Vote submissions allowed per IP address, per rolling window.
# Deliberately generous: guild-mates frequently share a network or a mobile CGNAT.
RL_VOTE_IP_MAX="40"
RL_VOTE_IP_WINDOW_SECONDS="3600"

# IGN claim / session-creation attempts allowed per IP, per rolling window.
RL_CLAIM_IP_MAX="30"
RL_CLAIM_IP_WINDOW_SECONDS="900"

# Admin login attempts allowed per IP, per rolling window.
RL_LOGIN_IP_MAX="10"
RL_LOGIN_IP_WINDOW_SECONDS="900"

# Consecutive failed logins before an admin account is temporarily locked.
ADMIN_LOCKOUT_THRESHOLD="8"
ADMIN_LOCKOUT_MINUTES="15"

# --- CAPTCHA (optional) ----------------------------------------------------
# "none" disables it entirely. "turnstile" enables Cloudflare Turnstile on
# events that have `requireCaptcha` switched on by an administrator.
CAPTCHA_PROVIDER="none"
# TURNSTILE_SECRET_KEY=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Trusted proxy ---------------------------------------------------------
# Number of reverse proxies in front of the app. Controls how far back into
# X-Forwarded-For the client IP is read. 0 = no proxy (use socket address).
# Vercel / Fly / most PaaS = 1. Getting this wrong breaks IP abuse protection.
TRUSTED_PROXY_HOPS="0"

# --- Seeding (development only) --------------------------------------------
SEED_ADMIN_NAME="Seed Administrator"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe!Dev12345"
