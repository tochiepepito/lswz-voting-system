{
  "name": "game-event-voting-system",
  "version": "1.0.0",
  "private": true,
  "description": "Login-free, IGN-based voting and election system for online gaming communities.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "secrets:generate": "tsx scripts/generate-secrets.ts",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:integration": "vitest run --configLoader runner -c vitest.integration.config.mjs",
    "test:all": "npm run test && npm run test:integration"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@types/node": "20.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.5.6",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
